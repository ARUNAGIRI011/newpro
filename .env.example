# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SANDBOX_API_TOKEN=
SANDBOX_CHANGE_APPROVAL_TOKEN=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# VMware vCenter/ESXi. Use a least-privilege account and a trusted TLS certificate.
VSPHERE_URL=https://vcenter.example.com/sdk
VSPHERE_USERNAME=
VSPHERE_PASSWORD=
VSPHERE_TEMPLATE_PATH=/Datacenter/vm/Templates/Ubuntu-24.04
VSPHERE_INSECURE_SKIP_VERIFY=false

# Hyper-V host accessed from the Linux Docker container over WinRM HTTPS (5986).
HYPERV_WINRM_HOST=
HYPERV_WINRM_PORT=5986
HYPERV_WINRM_USERNAME=
HYPERV_WINRM_PASSWORD=
HYPERV_TEMPLATE_VHDX=
HYPERV_VM_ROOT=
HYPERV_SWITCH_NAME=
